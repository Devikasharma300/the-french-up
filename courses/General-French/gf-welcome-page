  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&display=swap" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">

  <style>
    :root {
      --red: #ef2020;
      --red-dark: #cf1b1b;
      --ink: #222;
      --muted: #444;
      --line: #e5e5e5;
      --cream: #f7f7f7;
    }

    *, *::before, *::after {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      color: var(--ink);
      background: #fff;
      font-family: 'Avenir Next', Avenir, Helvetica, Arial, sans-serif;
      font-size: 15px;
      line-height: 1.65;
    }

    h1, h2, h3, p {
      margin-top: 0;
    }

    h1, h2, h3 {
      font-family: 'Playfair Display', Georgia, serif;
      line-height: 1.22;
    }

    a {
      color: inherit;
    }

    a:focus-visible,
    button:focus-visible {
      outline: 3px solid var(--red);
      outline-offset: 4px;
    }

    .wrap {
      width: min(1160px, 92%);
      margin-inline: auto;
    }

    .skip {
      position: absolute;
      top: -90px;
      left: 12px;
      z-index: 200;
      background: #fff;
      padding: 9px 15px;
    }

    .skip:focus {
      top: 8px;
    }

    /* HEADER */

    .header {
      position: sticky;
      top: 0;
      z-index: 20;
      background: #fff;
      border-bottom: 1px solid #eee;
    }

    .header-inner {
      min-height: 62px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      padding: 5px 18px;
    }

    .brand {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 120px;
      min-height: 42px;
      padding: 10px 14px;
      background: var(--red-dark);
      color: #fff;
      font-size: 13px;
      line-height: 1.15;
      letter-spacing: .07em;
      text-decoration: none;
      text-transform: uppercase;
    }

    .nav {
      display: flex;
      align-items: center;
      gap: 32px;
    }

    .nav a,
    .nav button {
      font: inherit;
      font-size: 13px;
      text-decoration: none;
      background: none;
      border: 0;
      color: var(--ink);
      cursor: pointer;
      padding: 9px 0;
    }

    .nav a:hover,
    .nav button:hover {
      color: var(--red);
    }

    .nav-drop {
      position: relative;
    }

    .nav-drop > button span {
      margin-left: 5px;
      font-size: 12px;
    }

    .drop-menu {
      display: none;
      position: absolute;
      right: 0;
      top: 100%;
      min-width: 225px;
      padding: 8px 0;
      background: #fff;
      border: 1px solid var(--line);
      box-shadow: 0 14px 48px rgba(20,20,20,.1);
      border-radius: 4px;
    }

    .nav-drop:hover .drop-menu,
    .nav-drop:focus-within .drop-menu,
    .nav-drop.open .drop-menu {
      display: block;
    }

    .drop-menu a {
      display: block;
      padding: 11px 18px;
    }

    .drop-menu a:hover {
      background: var(--red-dark);
      color: #fff;
    }

    /* HERO */

    .hero {
      background: var(--red);
      color: #fff;
    }

    .hero-inner {
      padding: 32px 0 56px;
    }

    .crumbs {
      font-size: 12px;
      color: #ffe3e2;
      margin-bottom: 23px;
    }

    .crumbs a {
      text-decoration: none;
    }

    .crumbs span {
      margin: 0 9px;
      opacity: .7;
    }

    .eyebrow {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: .17em;
      text-transform: uppercase;
    }

    .hero .eyebrow {
      color: #ffe1df;
      margin-bottom: 12px;
    }

    .hero h1 {
      font-size: clamp(40px, 5vw, 60px);
      margin-bottom: 15px;
      letter-spacing: -.025em;
    }

    .hero p:last-child {
      max-width: 640px;
      font-size: 16px;
      line-height: 1.8;
      color: rgba(255,255,255,.94);
      margin: 0;
    }

    /* COURSE SECTION */

    .courses {
      width: min(1320px, 94%);
      padding: 90px 0 105px;
    }

    .heading {
      text-align: center;
      max-width: 700px;
      margin: 0 auto 60px;
    }

    .section-kicker {
      color: var(--red);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: .18em;
      text-transform: uppercase;
      margin-bottom: 12px;
    }

    .heading h2 {
      font-size: clamp(30px, 3.4vw, 39px);
      margin-bottom: 12px;
    }

    .heading p {
      color: #444;
      margin: 0;
      font-size: 15px;
    }

    .heading .section-kicker {
      color: var(--red);
      margin-bottom: 12px;
      font-size: 11px;
    }

    /* THREE COURSE BOXES */

    .course-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 86px;
    }

    .course-card {
      display: flex;
      flex-direction: column;
      position: relative;
      min-height: 340px;
      padding: 26px 20px 22px;
      border: 2px solid var(--red);
      background: #fff;
      transition:
        box-shadow .25s ease,
        transform .25s ease,
        border-color .25s ease;
    }

    .course-card:hover,
    .course-card:focus-within {
      box-shadow: 0 20px 44px rgba(34,34,34,.11);
      transform: translateY(-5px);
    }

    .card-level {
      display: inline-flex;
      align-self: flex-start;
      padding: 9px 14px;
      background: #fff4f4;
      color: var(--red-dark);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: .13em;
      text-transform: uppercase;
      margin-bottom: 22px;
    }

    .course-card h3 {
      font-size: clamp(24px, 2.4vw, 29px);
      line-height: 1.28;
      margin-bottom: 18px;
      letter-spacing: -.015em;
    }

    .course-card h3 span {
      display: block;
      font-size: 21px;
      color: var(--red);
      margin-top: 9px;
    }

    .card-audience {
      font-size: 13px;
      font-weight: 700;
      color: var(--ink);
      margin-bottom: 11px;
      line-height: 1.6;
    }

    .card-copy {
      font-size: 14px;
      color: #444;
      line-height: 1.85;
      margin-bottom: 32px;
    }

    .course-link {
      position: static;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      align-self: stretch;
      margin-top: auto;
      min-height: 49px;
      padding: 12px 17px;
      background: var(--ink);
      color: #fff;
      font-size: 13px;
      font-weight: 700;
      text-decoration: none;
      transition: background .2s ease;
    }

    /* Make entire card clickable */

    .course-link::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 1;
    }

    .course-card:hover .course-link,
    .course-link:hover {
      background: var(--red);
    }

    .course-card:has(.course-link:focus-visible) {
      outline: 3px solid var(--red);
      outline-offset: 5px;
    }

    /* HELP SECTION */

    .help {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 30px;
      margin-top: 90px;
      padding: 31px 36px;
      background: var(--cream);
      border: 1px solid var(--line);
    }

    .help h2 {
      font-size: 22px;
      margin: 0 0 7px;
    }

    .help p {
      font-size: 14px;
      color: var(--muted);
      margin: 0;
    }

    .help a {
      display: inline-flex;
      justify-content: center;
      align-items: center;
      flex-shrink: 0;
      background: var(--red);
      color: #fff;
      min-height: 48px;
      padding: 12px 22px;
      text-decoration: none;
      font-size: 13px;
      font-weight: 700;
    }

    .help a:hover {
      background: var(--red-dark);
    }

    /* FOOTER */

    .site-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
      padding: 34px 4% 70px;
      background: #f2f2f2;
      border-top: 1px solid var(--line);
      color: #444;
      font-size: 12px;
    }

    .footer-left {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 20px;
    }

    .site-footer a {
      color: #444;
      text-decoration: underline;
    }

    .site-footer a:hover {
      color: var(--red);
    }

    .footer-social{display:flex;gap:16px}
    .footer-social a{font-size:16px;text-decoration:none}

    .chat{position:fixed;bottom:20px;right:20px;z-index:90;background:var(--red);color:#fff;text-decoration:none;font:700 18px 'Playfair Display',Georgia,serif;padding:15px 24px}
    .chat:hover{background:var(--red-dark)}

    @media (max-width: 900px) {
      .header { position: relative; }
    }

    /* RESPONSIVE DESIGN */

    @media (max-width: 1150px) {
      .course-grid {
        gap: 48px;
      }

      .course-card {
        padding: 24px 18px;
        min-height: 340px;
      }
    }

    @media (max-width: 850px) {
      .course-grid {
        grid-template-columns: 1fr;
        max-width: 540px;
        margin-inline: auto;
        gap: 34px;
      }

      .course-card {
        min-height: 0;
        padding: 26px 22px;
      }

      .card-level {
        margin-bottom: 20px;
      }

      .card-copy {
        margin-bottom: 28px;
      }

      .nav {
        gap: 18px;
      }

      .help {
        max-width: 680px;
        margin: 45px auto 0;
      }
    }

    @media (max-width: 700px) {
      .help {
        flex-direction: column;
        align-items: flex-start;
      }

      .hero-inner {
        padding: 28px 0 43px;
      }

      .courses {
        padding: 64px 0 75px;
      }

      .heading {
        margin-bottom: 40px;
      }
    }

    @media (max-width: 600px) {
      .header-inner {
        flex-wrap: wrap;
        justify-content: center;
        gap: 6px;
        padding: 10px;
      }

      .nav {
        gap: 14px;
        justify-content: center;
        flex-wrap: wrap;
      }

      .nav a,
      .nav button {
        font-size: 12px;
      }

      .hero h1 {
        font-size: 39px;
      }

      .hero p:last-child {
        font-size: 14px;
      }

      .course-card {
        padding: 29px 25px;
      }

      .course-card h3 {
        font-size: 27px;
      }

      .help {
        padding: 25px;
      }

      .site-footer {
        align-items: flex-start;
        flex-direction: column;
      }
    }

    @media (max-width: 600px) {
      .chat{right:12px;bottom:12px;padding:11px 15px;font-size:15px}
      a.chat{width:52px;height:52px;min-height:0;padding:0;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:0}
      a.chat span{font-size:24px;line-height:1}
      .eyebrow,.section-kicker,.card-level{font-size:12px}
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        transition: none !important;
      }
    }
  </style>
</head>

